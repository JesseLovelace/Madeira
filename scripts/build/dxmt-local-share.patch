 #include "winemetal.h"
 #include <atomic>
 #include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+namespace dxmt {
+
+/* Textures shared without a mach port (iOS cannot register one): the shared
+ * handle names an entry in this process-local table, which another graphics
+ * runtime in the same process (the D3D12 layer) reads through the exported
+ * MadeiraSharedTextureLookup. Same-process sharing is what D3D11 -> D3D12
+ * interop of one application needs. */
+struct LocalShare {
+  obj_handle_t texture;
+  D3D11_TEXTURE2D_DESC desc;
+};
+static std::mutex g_local_share_lock;
+static std::unordered_map<uintptr_t, LocalShare> g_local_shares;
+static uintptr_t g_local_share_next = 0;
+
+static uintptr_t
+LocalShareAdd(obj_handle_t texture, const D3D11_TEXTURE2D_DESC &desc) {
+  std::lock_guard<std::mutex> lock(g_local_share_lock);
+  /* KMT-style global handle: the 0xc0000000 bits mark a global share. */
+  uintptr_t h = 0xc0000000u | ((++g_local_share_next & 0x0fffffffu) << 2);
+  NSObject_retain(texture);
+  g_local_shares[h] = {texture, desc};
+  return h;
+}
+
+static void
+LocalShareRemove(uintptr_t h) {
+  obj_handle_t texture = 0;
+  {
+    std::lock_guard<std::mutex> lock(g_local_share_lock);
+    auto it = g_local_shares.find(h);
+    if (it == g_local_shares.end())
+      return;
+    texture = it->second.texture;
+    g_local_shares.erase(it);
+  }
+  NSObject_release(texture);
+}
+
+} // namespace dxmt
+
+/* Returns the Metal texture behind a local shared handle with a reference the
+ * caller releases, and its description. */
+extern "C" BOOL WINAPI
+MadeiraSharedTextureLookup(HANDLE handle, obj_handle_t *texture, D3D11_TEXTURE2D_DESC *desc) {
+  using namespace dxmt;
+  std::lock_guard<std::mutex> lock(g_local_share_lock);
+  auto it = g_local_shares.find(reinterpret_cast<uintptr_t>(handle));
+  if (it == g_local_shares.end())
+    return FALSE;
+  NSObject_retain(it->second.texture);
+  *texture = it->second.texture;
+  if (desc)
+    *desc = it->second.desc;
+  return TRUE;
+}
 
