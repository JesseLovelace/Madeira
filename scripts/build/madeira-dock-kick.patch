+/* Ending another device's playing session (refusal 35), as desktop Steam's
+ * "continue launching" does: IClientUser::BKickOtherPlayingSession(), no
+ * arguments, returns bool. Its slot is not pinned for either build, so the
+ * host looks for the one IPC wrapper that names the method through a
+ * RIP-relative LEA (the check tools/check-client-layout.py makes for slot 71).
+ * Nothing is called unless exactly one slot in range names it.
+ */
+#define SH_KICK_FIRST_SLOT 200
+#define SH_KICK_LAST_SLOT 250
+typedef bool (__thiscall *kick_fn)(void *);
+
+static bool image_bounds(HMODULE module, uintptr_t *low, uintptr_t *high)
+{
+    const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)module;
+    if (!dos || dos->e_magic != IMAGE_DOS_SIGNATURE) return false;
+    const IMAGE_NT_HEADERS64 *nt = (const IMAGE_NT_HEADERS64 *)((const char *)module + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC) return false;
+    *low = (uintptr_t)module;
+    *high = *low + nt->OptionalHeader.SizeOfImage;
+    return true;
+}
+
+static bool wrapper_names(uintptr_t low, uintptr_t high, uintptr_t code, const char *name)
+{
+    const size_t limit = 0x200, length = strlen(name) + 1;
+    if (code < low || code + limit > high) return false;
+    const unsigned char *p = (const unsigned char *)code;
+    for (size_t i = 0; i + 7 <= limit; ++i) {
+        if ((p[i] != 0x48 && p[i] != 0x4c) || p[i+1] != 0x8d || (p[i+2] & 0xc7) != 0x05) continue;
+        int32_t displacement;
+        memcpy(&displacement, p + i + 3, 4);
+        uintptr_t target = code + i + 7 + (intptr_t)displacement;
+        if (target >= low && target + length <= high && !memcmp((const void *)target, name, length)) return true;
+    }
+    return false;
+}
+
+static int kick_slot(HMODULE module, void *client_user)
+{
+    uintptr_t low, high;
+    if (!client_user || !image_bounds(module, &low, &high)) return -1;
+    void **table = *(void ***)client_user;
+    if ((uintptr_t)table < low || (uintptr_t)(table + SH_KICK_LAST_SLOT + 1) > high) return -1;
+    int found = -1;
+    for (int slot = SH_KICK_FIRST_SLOT; slot <= SH_KICK_LAST_SLOT; ++slot) {
+        if (!wrapper_names(low, high, (uintptr_t)table[slot], "BKickOtherPlayingSession")) continue;
+        if (found >= 0) return -1;
+        found = slot;
+    }
+    return found;
+}
+
+/* Madeira writes the answer file (MADEIRA_DOCK_SESSION_ANSWER) when the user
+ * agrees to end the other session; the host removes it once read.
+ */
+static bool session_answer_yes(const wchar_t *path)
+{
+    if (!path[0] || GetFileAttributesW(path) == INVALID_FILE_ATTRIBUTES) return false;
+    HANDLE file = CreateFileW(path, GENERIC_READ | DELETE, 0, NULL, OPEN_EXISTING, 0, NULL);
+    char value[4] = {0};
+    DWORD got = 0;
+    if (file != INVALID_HANDLE_VALUE) {
+        ReadFile(file, value, sizeof(value) - 1, &got, NULL);
+        CloseHandle(file);
+    }
+    DeleteFileW(path);
+    return got >= 1 && value[0] == '1';
+}
